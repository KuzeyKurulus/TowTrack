# Bu dosya proje için gereken ortam değişkenlerinin bir örneğidir.
# Gerçek değerlerinizi içeren .env dosyasını ASLA repoya eklemeyin.

# ---- Backend ----
# SQLite bağlantı dizesi (varsayılan olarak proje klasöründe bir dosya oluşturur)
ConnectionStrings__DefaultConnection=Data Source=towtrack.db

# ---- Frontend ----
# API sunucusunun adresi (frontend/.env dosyasına da eklenebilir)
VITE_API_URL=http://localhost:5080/api
